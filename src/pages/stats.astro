---
import { getCollection } from 'astro:content';
import { isPublished } from '../utils/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostStats from '../components/PostStats.astro';
import { getPostStats, getRollup, getSiteMetrics, getStatsAsOf } from '../utils/post-stats';
import { formatDateShort } from '../utils/dates';

const posts = (await getCollection('blog', ({ data }) => isPublished(data)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const rollup = getRollup();
const site = getSiteMetrics();
const asOf = getStatsAsOf();

const pct = (v: number | null) => (v === null ? '—' : `${(v * 100).toFixed(1)}%`);
const secs = (v: number | null) => (v === null ? '—' : `${Math.round(v)}s`);
const num = (v: number | null) => (v === null ? '—' : v.toLocaleString());
const siteVitals = [
  { label: 'Page views', value: num(site.pageviews) },
  { label: 'Visitors', value: num(site.visitors) },
  { label: 'Sessions', value: num(site.sessions) },
  { label: 'Engagement', value: pct(site.engagementRate) },
  { label: 'Avg session', value: secs(site.avgSessionSeconds) },
  { label: 'Search CTR', value: pct(site.searchCtr) },
  { label: 'Avg position', value: site.searchPosition === null ? '—' : `#${site.searchPosition.toFixed(1)}` },
];
---

<BaseLayout
  title="Telemetry | Build in the Open"
  description="Live readout across every post — views, impressions, and which posts are ranking for their target keyword."
>
  <div class="stats-page">
    <header class="page-header">
      <span class="page-label">// telemetry</span>
      <h1>Signal across every post</h1>
      <p class={`stats-asof${asOf.stale ? ' stats-asof--stale' : ''}`}>
        as of {formatDateShort(asOf.date)}{asOf.stale ? ' — stats may be stale' : ''}
      </p>
    </header>

    <div class="vitals">
      <span class="vitals-label">// site vitals (28d) — GA4 + Search Console, whole site</span>
      <div class="vitals-grid">
        {siteVitals.map((v) => (
          <div class="rollup-stat">
            <span class="rollup-value">{v.value}</span>
            <span class="rollup-label">{v.label}</span>
          </div>
        ))}
      </div>
    </div>

    <span class="rollup-caption">// posts only (28d)</span>
    <div class="rollup">
      <div class="rollup-stat">
        <span class="rollup-value">{rollup.totalPageviews.toLocaleString()}</span>
        <span class="rollup-label">Views (28d)</span>
      </div>
      <div class="rollup-stat">
        <span class="rollup-value">{rollup.totalImpressions.toLocaleString()}</span>
        <span class="rollup-label">Impressions (28d)</span>
      </div>
      <div class="rollup-stat">
        <span class="rollup-value">{rollup.totalClicks}</span>
        <span class="rollup-label">Clicks (28d)</span>
      </div>
      <div class="rollup-stat">
        <span class="rollup-value">{rollup.postsRankingForTarget}/{rollup.postsMeasured}</span>
        <span class="rollup-label">Ranking for target</span>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <>
        <div class="controls">
          <input
            id="stats-search"
            type="search"
            class="control-input"
            placeholder="filter by title…"
            aria-label="Filter posts by title"
          />
          <label class="control-field">
            <span>Show</span>
            <select id="stats-filter" class="control-select">
              <option value="all">all posts</option>
              <option value="measured">ranking for target</option>
              <option value="views">with views</option>
            </select>
          </label>
          <label class="control-field">
            <span>Sort</span>
            <select id="stats-sort" class="control-select">
              <option value="date">newest</option>
              <option value="views">most views</option>
              <option value="impressions">most impressions</option>
              <option value="clicks">most clicks</option>
              <option value="position">best position</option>
              <option value="title">title A–Z</option>
            </select>
          </label>
          <span id="stats-count" class="control-count"></span>
        </div>
        <table class="stats-table">
          <thead>
            <tr>
              <th>Post</th>
              <th>Stats</th>
            </tr>
          </thead>
          <tbody id="stats-rows">
            {posts.map((post) => {
              const st = getPostStats(post.id);
              return (
                <tr
                  data-title={post.data.title.toLowerCase()}
                  data-date={post.data.pubDate.valueOf()}
                  data-views={st?.pageviews ?? 0}
                  data-impressions={st?.impressions ?? 0}
                  data-clicks={st?.clicks ?? 0}
                  data-position={st && st.position > 0 ? st.position : ''}
                  data-status={st?.scorecard.status ?? 'none'}
                >
                  <td><a href={`/blog/${post.id}/`}>{post.data.title}</a></td>
                  <td><PostStats stat={st} variant="full" /></td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <p id="stats-empty" class="empty" hidden>No posts match those filters.</p>
      </>
    )}
  </div>

  <script>
    const search = document.getElementById('stats-search') as HTMLInputElement | null;
    const filter = document.getElementById('stats-filter') as HTMLSelectElement | null;
    const sort = document.getElementById('stats-sort') as HTMLSelectElement | null;
    const tbody = document.getElementById('stats-rows');
    const count = document.getElementById('stats-count');
    const emptyMsg = document.getElementById('stats-empty');

    if (search && filter && sort && tbody) {
      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
      const n = (r: HTMLElement, k: string) => Number(r.dataset[k] || 0);

      const apply = () => {
        const q = search.value.trim().toLowerCase();
        const mode = filter.value;

        for (const r of rows) {
          const matchesText = !q || (r.dataset.title || '').includes(q);
          const matchesFilter =
            mode === 'all' ||
            (mode === 'measured' && r.dataset.status === 'measured' && r.dataset.position !== '') ||
            (mode === 'views' && n(r, 'views') > 0);
          r.hidden = !(matchesText && matchesFilter);
        }

        const visible = rows.filter((r) => !r.hidden);
        const by = sort.value;
        visible.sort((a, b) => {
          if (by === 'title') return (a.dataset.title || '').localeCompare(b.dataset.title || '');
          if (by === 'position') {
            // Lower position is better; unranked (empty) sinks to the bottom.
            const pa = a.dataset.position === '' ? Infinity : n(a, 'position');
            const pb = b.dataset.position === '' ? Infinity : n(b, 'position');
            return pa - pb;
          }
          if (by === 'date') return n(b, 'date') - n(a, 'date');
          return n(b, by) - n(a, by); // views | impressions | clicks
        });
        for (const r of visible) tbody.appendChild(r);

        if (count) count.textContent = `${visible.length} of ${rows.length}`;
        if (emptyMsg) emptyMsg.hidden = visible.length > 0;
      };

      search.addEventListener('input', apply);
      filter.addEventListener('change', apply);
      sort.addEventListener('change', apply);
      apply();
    }
  </script>
</BaseLayout>

<style>
  .stats-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem var(--gutter) 4rem;
    animation: fadeUp 0.6s ease both;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  .page-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
    margin-bottom: 0.6rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .stats-asof {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    opacity: 0.75;
  }

  .stats-asof--stale {
    color: #e0a94c;
    opacity: 1;
  }

  .vitals {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }

  .vitals-label,
  .rollup-caption {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-bottom: 0.9rem;
  }

  .rollup-caption {
    margin-bottom: 0.5rem;
  }

  .vitals-grid {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .rollup {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .rollup-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rollup-value {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--color-text);
  }

  .rollup-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .control-input,
  .control-select {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    padding: 0.5rem 0.7rem;
  }

  .control-input {
    flex: 1;
    min-width: 12rem;
  }

  .control-input:focus-visible,
  .control-select:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }

  .control-field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }

  .control-count {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    margin-left: auto;
  }

  @media (max-width: 560px) {
    .control-count {
      margin-left: 0;
    }
  }

  .stats-table {
    width: 100%;
    border-collapse: collapse;
  }

  .stats-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    padding: 0 0 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .stats-table td {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--color-border);
    vertical-align: top;
  }

  .stats-table td:first-child {
    max-width: 28ch;
  }

  .stats-table a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .stats-table a:hover {
    color: var(--color-accent);
  }

  .empty {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    padding: 3rem 0;
    text-align: center;
  }
</style>
