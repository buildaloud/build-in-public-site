---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { isPublished } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => isPublished(data)))
    .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost: posts[i - 1] ? { slug: posts[i - 1].id, title: posts[i - 1].data.title } : null,
      nextPost: posts[i + 1] ? { slug: posts[i + 1].id, title: posts[i + 1].data.title } : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  author={post.data.author}
  slug={post.id}
  tags={post.data.tags}
  heroImage={post.data.heroImage}
  heroImageAlt={post.data.heroImageAlt}
  summary={post.data.summary}
  targetKeyword={post.data.targetKeyword}
  secondaryKeywords={post.data.secondaryKeywords}
  searchIntent={post.data.searchIntent}
  audience={post.data.audience}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
