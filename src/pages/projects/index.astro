---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { projects, type Project } from '../../data/projects';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const postCount = (slug: string) =>
  posts.filter((p) => p.data.project === slug).length;

const statusOrder: Record<Project['status'], number> = {
  active: 0,
  exploring: 1,
  paused: 2,
  shipped: 3,
};

const sorted = projects
  .filter((p) => postCount(p.slug) > 0)
  .sort((a, b) => statusOrder[a.status] - statusOrder[b.status]);
---

<BaseLayout
  title="Projects | Build Aloud"
  description="Everything being built in the open under Build Aloud — solo and with co-builders. Status, collaborators, and the posts that tell each story."
>
  <div class="projects-page">
    <header class="page-header">
      <span class="page-label">// projects</span>
      <h1>What we're building</h1>
      <p class="page-desc">
        Build Aloud is the umbrella. Each project below is built in the open —
        some solo, some with a co-builder. Follow the posts to watch them grow.
      </p>
    </header>

    <ul class="project-grid">
      {sorted.map((proj) => (
        <li class={`project-card status-${proj.status}`}>
          <a class="card-link" href={`/projects/${proj.slug}/`} aria-label={`${proj.name} — view project`}></a>
          <div class="card-top">
            <span class={`status-badge status-${proj.status}`}>{proj.status}</span>
            <span class="builders">
              {proj.builders.join(' + ')}
            </span>
          </div>

          <h2>{proj.name}</h2>
          <p class="blurb">{proj.blurb}</p>

          {proj.tags && proj.tags.length > 0 && (
            <div class="tags">
              {proj.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )}

          <div class="card-foot">
            <div class="links">
              {proj.liveUrl && (
                <a href={proj.liveUrl} class="proj-link" target="_blank" rel="noopener">
                  live ↗
                </a>
              )}
              {proj.repoUrl && (
                <a href={proj.repoUrl} class="proj-link" target="_blank" rel="noopener">
                  repo ↗
                </a>
              )}
            </div>
            <span class="post-count">
              {postCount(proj.slug)} {postCount(proj.slug) === 1 ? 'post' : 'posts'}
            </span>
          </div>
        </li>
      ))}
    </ul>

    {sorted.length === 0 && <p class="empty">No projects yet.</p>}
  </div>
</BaseLayout>

<style>
  .projects-page {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem var(--gutter) 4rem;
    animation: fadeUp 0.6s ease both;
  }

  /* ── Header ── */
  .page-header {
    margin-bottom: 3rem;
  }

  .page-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
    display: block;
    margin-bottom: 1rem;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .page-desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    line-height: 1.6;
    max-width: 38rem;
  }

  /* ── Grid ── */
  .project-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--color-accent);
    transition: height 0.3s ease;
    border-radius: 0 0 2px 0;
  }

  .project-card:hover {
    border-color: var(--color-border-hover);
    box-shadow: 0 0 30px var(--color-accent-dim);
    transform: translateY(-1px);
  }

  .project-card:hover::before {
    height: 100%;
  }

  .project-card.status-paused::before {
    background: var(--color-muted);
  }

  /* ── Card top ── */
  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    letter-spacing: 0.04em;
    text-transform: lowercase;
  }

  .status-badge.status-active {
    color: var(--color-accent);
    background: var(--color-accent-dim);
    border: 1px solid rgba(163, 247, 191, 0.18);
  }

  .status-badge.status-exploring {
    color: var(--color-accent);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .status-badge.status-paused {
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .status-badge.status-shipped {
    color: var(--color-text-secondary);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .builders {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
    opacity: 0.85;
  }

  /* ── Body ── */
  /* Stretched link — makes the whole card clickable */
  .card-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  h2 {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 400;
    margin-bottom: 0.5rem;
    line-height: 1.3;
    color: var(--color-text);
    transition: color 0.2s ease;
  }

  .project-card:hover h2 {
    color: var(--color-accent);
  }

  .blurb {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    margin: 0 0 0.85rem;
    line-height: 1.55;
    flex: 1;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-accent);
    opacity: 0.7;
    letter-spacing: 0.01em;
  }

  /* ── Foot ── */
  .card-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .links {
    display: flex;
    gap: 0.85rem;
    position: relative;
    z-index: 2;
  }

  .proj-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
    opacity: 0.8;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .proj-link:hover {
    opacity: 1;
  }

  .post-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .empty {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-muted);
    padding: 3rem 0;
    text-align: center;
  }
</style>
