---
import type { PostStat, Scorecard } from '../../scripts/stats/post-stats';
import Sparkline from './charts/Sparkline.astro';

// dailyViews is a pinned-contract field the stats:pull side is adding to
// PostStat; not yet declared on the shared type, so read it defensively —
// absent on any snapshot generated before that field lands.
type PostStatWithDaily = PostStat & { dailyViews?: number[] };

interface Props {
  stat: PostStat | null;
  variant: 'compact' | 'full';
  // Only needed to build the giscus comments-anchor link on the comments cell
  // below; compact/index callers that don't pass it simply skip that link.
  slug?: string;
}

const { stat, variant, slug } = Astro.props;
const dailyViews = (stat as PostStatWithDaily | null)?.dailyViews;
const comments = stat?.comments;

type Tone = 'hit' | 'miss' | 'unknown';

function signal(scorecard: Scorecard): { label: string; tone: Tone } {
  if (scorecard.status === 'insufficient-data') {
    return { label: 'gathering signal — not enough search data yet', tone: 'unknown' };
  }
  return scorecard.rankedForTarget
    ? { label: `ranking for "${scorecard.targetKeyword}" · avg #${scorecard.targetPosition?.toFixed(1)}`, tone: 'hit' }
    : { label: `not yet ranking for "${scorecard.targetKeyword}"`, tone: 'miss' };
}

const badge = stat ? signal(stat.scorecard) : null;
const pos = stat && stat.position > 0 ? `#${stat.position.toFixed(1)}` : '—';
const ctr = stat && stat.ctr > 0 ? `${(stat.ctr * 100).toFixed(1)}%` : '0%';
---

{variant === 'compact' && stat && (
  <span class="tele-compact" data-tone={badge?.tone}>
    <span class="tele-dot" aria-hidden="true"></span>
    {stat.pageviews} view{stat.pageviews === 1 ? '' : 's'}
  </span>
)}

{variant === 'full' && !stat && (
  <p class="tele-empty">no signal yet — this post isn&rsquo;t indexed. check back after the next crawl.</p>
)}

{variant === 'full' && stat && badge && (
  <div class="tele">
    <div class="tele-hero">
      <span class="tele-num">{stat.pageviews.toLocaleString()}</span>
      <span class="tele-unit">view{stat.pageviews === 1 ? '' : 's'}<span class="tele-window">28d</span></span>
      <span class="tele-spark"><Sparkline dailyViews={dailyViews} /></span>
    </div>
    <div class="tele-rule" aria-hidden="true"></div>
    <dl class="tele-grid">
      <div><dt>impressions</dt><dd>{stat.impressions.toLocaleString()}</dd></div>
      <div><dt>avg pos</dt><dd>{pos}</dd></div>
      <div><dt>clicks</dt><dd>{stat.clicks}</dd></div>
      <div><dt>ctr</dt><dd>{ctr}</dd></div>
      {comments !== undefined && (
        <div>
          <dt>comments</dt>
          <dd>
            {comments > 0 && slug ? (
              <a class="tele-comments-link" href={`/blog/${slug}/#comments`}>{comments}</a>
            ) : comments}
          </dd>
        </div>
      )}
    </dl>
    <p class={`tele-signal tele-signal--${badge.tone}`}>
      <span class="tele-dot" aria-hidden="true"></span>
      {badge.label}
    </p>
  </div>
)}

<style>
  /* ── compact (feed cards) ── */
  .tele-compact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-secondary);
  }

  /* ── the live-signal dot: the one bold element, glows on a ranking hit ── */
  .tele-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
    flex-shrink: 0;
  }

  [data-tone='hit'] .tele-dot,
  .tele-signal--hit .tele-dot {
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
    animation: tele-pulse 2.4s ease-in-out infinite;
  }

  .tele-signal--miss .tele-dot {
    background: var(--color-hot);
  }

  @keyframes tele-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tele-dot { animation: none; }
  }

  /* ── empty state ── */
  .tele-empty {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--color-muted);
  }

  /* ── full readout ── */
  .tele {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .tele-hero {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    flex-wrap: wrap;
  }

  .tele-spark {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }

  .tele-num {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 7vw, 3.2rem);
    line-height: 0.9;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .tele-unit {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .tele-window {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 0.2rem;
    padding: 0.1rem 0.3rem;
  }

  .tele-rule {
    height: 0;
    border-top: 1px dashed var(--color-border);
  }

  .tele-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem 1rem;
    margin: 0;
  }

  @media (max-width: 30rem) {
    .tele-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .tele-grid dt {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.2rem;
  }

  .tele-grid dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .tele-comments-link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-hover);
    text-underline-offset: 0.15em;
  }

  .tele-comments-link:hover {
    color: var(--color-accent);
  }

  .tele-signal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  .tele-signal--hit { color: var(--color-accent); }
  .tele-signal--miss { color: var(--color-text-secondary); }
  .tele-signal--unknown { color: var(--color-muted); }
</style>
