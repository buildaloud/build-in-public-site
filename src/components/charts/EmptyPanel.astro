---
interface Props {
  label?: string;
}

const { label = 'gathering signal — not enough data yet' } = Astro.props;
---

<div class="chart-empty">
  <span class="chart-empty-dot" aria-hidden="true"></span>
  {label}
</div>

<style>
  .chart-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    padding: 2.5rem 0;
    text-align: center;
  }

  .chart-empty-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-muted);
    flex-shrink: 0;
  }
</style>
