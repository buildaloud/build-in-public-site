---
import BaseLayout from './BaseLayout.astro';
import LocalTime from '../components/LocalTime.astro';
import PostStats from '../components/PostStats.astro';
import LikeButton from '../components/LikeButton.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { getPostStats, getStatsAsOf } from '../utils/post-stats';
import { formatDateShort } from '../utils/dates';

interface PostLink {
  slug: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  author: string;
  slug: string;
  tags?: string[];
  heroImage?: string;
  heroImageAlt?: string;
  summary?: string;
  targetKeyword?: string;
  secondaryKeywords?: string[];
  searchIntent?: string;
  audience?: string;
  prevPost?: PostLink | null;
  nextPost?: PostLink | null;
}

const { title, description, pubDate, author, slug, tags, heroImage, heroImageAlt, summary, targetKeyword, secondaryKeywords, searchIntent, audience, prevPost, nextPost } = Astro.props;

const stat = getPostStats(slug);
const asOf = getStatsAsOf();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { '@type': 'Person', name: author },
  url: new URL(`/blog/${slug}/`, Astro.site).toString(),
  ...(heroImage ? { image: new URL(heroImage, Astro.site).toString() } : {}),
};
---

<BaseLayout title={`${title} | Build in the Open`} description={description} heroImage={heroImage}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  <article class="blog-post">
    <header>
      <div class="post-meta-top">
        <a href="/" class="back-link">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M11 7H3M6 4L3 7l3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Back
        </a>
      </div>
      <h1>{title}</h1>
      <div class="meta">
        <LocalTime date={pubDate} />
        <span class="meta-dot" aria-hidden="true"></span>
        <span class="author">{author}</span>
      </div>
      {tags && tags.length > 0 && (
        <div class="tags">
          {tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}
    </header>
    {heroImage && (
      <div class="post-hero">
        <img src={heroImage} alt={heroImageAlt ?? `Cover image for ${title}`} />
      </div>
    )}
    {summary && (
      <aside class="ai-summary" aria-label="AI-generated summary">
        <div class="ai-summary-label">
          <span class="ai-summary-dot" aria-hidden="true"></span>
          AI summary
        </div>
        <p class="ai-summary-lead">{summary.lead}</p>
        <ul class="ai-summary-points">
          {summary.points.map((p) => <li>{p}</li>)}
        </ul>
        <p class="ai-summary-get"><span class="ai-summary-get-label">why read on</span>{summary.whatYouGet}</p>
      </aside>
    )}
    <aside class="post-stats-panel" aria-label="Post telemetry">
      <div class="post-stats-panel-label">// telemetry</div>
      <PostStats stat={stat} variant="full" />
      {targetKeyword && (
        <div class="targeting">
          <div class="targeting-label">// targeting</div>
          <dl class="targeting-list">
            <div><dt>target</dt><dd>&ldquo;{targetKeyword}&rdquo;</dd></div>
            {searchIntent && <div><dt>intent</dt><dd>{searchIntent}</dd></div>}
            {audience && <div><dt>for</dt><dd>{audience}</dd></div>}
            {secondaryKeywords && secondaryKeywords.length > 0 && (
              <div class="targeting-also"><dt>also</dt><dd>{secondaryKeywords.join(' · ')}</dd></div>
            )}
          </dl>
        </div>
      )}
      <p class={`post-stats-panel-asof${asOf.stale ? ' post-stats-panel-asof--stale' : ''}`}>
        as of {formatDateShort(asOf.date)}{asOf.stale ? ' — stats may be stale' : ''}
      </p>
    </aside>
    <div class="content">
      <slot />
    </div>
    <section class="comments">
      <div class="comments-header">
        <span class="comments-label">// comments</span>
      </div>
      <script
        src="https://giscus.app/client.js"
        data-repo="chadfurman/build-in-public-site"
        data-repo-id="R_kgDORVwLew"
        data-category="General"
        data-category-id="DIC_kwDORVwLe84C282K"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="0"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="dark_dimmed"
        data-lang="en"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </section>

    <footer class="post-footer">
      <div class="post-engagement">
        <LikeButton slug={slug} />
        <ShareButtons slug={slug} title={title} />
      </div>
      <div class="footer-line" aria-hidden="true"></div>
      <nav class="post-nav">
        {prevPost ? (
          <a href={`/blog/${prevPost.slug}/`} class="post-nav-link prev">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M11 7H3M6 4L3 7l3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="post-nav-text">
              <span class="post-nav-label">Previous</span>
              <span class="post-nav-title">{prevPost.title}</span>
            </span>
          </a>
        ) : <div />}
        {nextPost ? (
          <a href={`/blog/${nextPost.slug}/`} class="post-nav-link next">
            <span class="post-nav-text">
              <span class="post-nav-label">Next</span>
              <span class="post-nav-title">{nextPost.title}</span>
            </span>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ) : <div />}
      </nav>
      <a href="/" class="back-home">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M11 7H3M6 4L3 7l3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        All entries
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .blog-post {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
    animation: fadeUp 0.6s ease both;
  }

  .content :global(img) {
    max-width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }

  .post-meta-top {
    margin-bottom: 2rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.15;
    font-weight: 400;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    margin-bottom: 0.75rem;
  }

  .meta-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--color-border-hover);
  }

  .tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
    opacity: 0.7;
  }

  /* Article hero image */
  .post-hero {
    margin: 0 0 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    overflow: hidden;
    background: var(--color-bg);
    aspect-ratio: 16 / 9;
  }

  .post-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* AI summary box */
  .ai-summary {
    position: relative;
    margin: 0 0 2.5rem;
    padding: 1.25rem 1.4rem;
    background: var(--color-accent-dim);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-accent);
    border-radius: 0.5rem;
  }

  .ai-summary-label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .ai-summary-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
    animation: aiPulse 2.4s ease-in-out infinite;
  }

  @keyframes aiPulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .ai-summary-lead {
    margin: 0 0 0.85rem;
    color: var(--color-text);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .ai-summary-points {
    margin: 0 0 0.85rem;
    padding-left: 1.1rem;
    list-style: none;
  }

  .ai-summary-points li {
    position: relative;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 0.35rem;
  }

  .ai-summary-points li::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 0.55em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.7;
  }

  .ai-summary-get {
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .ai-summary-get-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-right: 0.55rem;
    opacity: 0.85;
  }

  /* Telemetry panel */
  .post-stats-panel {
    margin: 0 0 2.5rem;
    padding: 1.1rem 1.4rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    border-radius: 0.5rem;
  }

  .post-stats-panel-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-bottom: 0.9rem;
  }

  /* Targeting sub-block */
  .targeting {
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
  }

  .targeting-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
    margin-bottom: 0.7rem;
  }

  .targeting-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.75rem;
    margin: 0;
  }

  .targeting-list dt {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    margin-bottom: 0.15rem;
  }

  .targeting-list dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-text);
  }

  .targeting-also { flex-basis: 100%; }
  .targeting-also dd { color: var(--color-text-secondary); }

  .post-stats-panel-asof {
    margin: 0.85rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-muted);
    opacity: 0.7;
  }

  .post-stats-panel-asof--stale {
    color: #e0a94c;
    opacity: 1;
  }

  /* Content styles */
  .content {
    line-height: 1.8;
    font-size: 1.02rem;
  }

  .content :global(h2) {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .content :global(h3) {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .content :global(p) {
    margin-bottom: 1.4rem;
    color: var(--color-text-secondary);
  }

  .content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgba(163, 247, 191, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s ease;
  }

  .content :global(a:hover) {
    text-decoration-color: var(--color-accent);
  }

  .content :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 1.25rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }

  .content :global(:not(pre) > code) {
    background: var(--color-surface);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
    font-size: 0.85em;
    color: var(--color-accent);
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.4rem;
    padding-left: 1.5rem;
    color: var(--color-text-secondary);
  }

  .content :global(li) {
    margin-bottom: 0.4rem;
  }

  .content :global(li::marker) {
    color: var(--color-accent);
    opacity: 0.5;
  }

  .content :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--color-text-secondary);
    font-style: italic;
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .content :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-border);
    margin: 2.5rem 0;
  }

  /* Comments */
  .comments {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .comments-header {
    margin-bottom: 1rem;
  }

  .comments-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  /* Post footer */
  .post-footer {
    margin-top: 3rem;
  }

  .post-engagement {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .footer-line {
    height: 1px;
    background: var(--color-border);
    margin-bottom: 1.5rem;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .post-nav-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-bg-elevated);
    transition: border-color 0.2s ease;
    max-width: 50%;
  }

  .post-nav-link:hover {
    border-color: var(--color-accent);
  }

  .post-nav-link.next {
    margin-left: auto;
    text-align: right;
  }

  .post-nav-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .post-nav-title {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--color-accent);
  }

  .back-home {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.2s ease;
  }

  .back-home:hover {
    color: var(--color-accent);
  }
</style>
